<?xml version="1.0" encoding="utf-8"?>
<!--
  首页。P1 的主入口，也是唯一的输入入口。

  形态上分两截：上面是可滚动的内容区（待处理、账本、报表、设置），
  下面是<b>贴在屏幕底部</b>的输入栏。输入栏贴底而不是跟着内容往下排，有两个原因：
  一是键盘弹起时它会被顶上来，视线不用挪；二是上面那截可以随便加内容，输入栏的位置不变。

  刻意不放「解析」「清空」两个按钮：上箭头就是发送，而发送即清空输入框
  （见 HANDOFF 决策 34），清空按钮因此没有存在意义。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingTop="20dp"
    android:paddingBottom="8dp"
    tools:context=".ui.ledger.MainActivity">

    <!-- 上面这截要能撑满剩余空间，所以 weight=1 + height=0dp；
         否则内容少的时候输入栏会被顶到屏幕中间 -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/home_title"
                android:textSize="32sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/home_subtitle"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/open_draft_count"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:background="?android:attr/selectableItemBackground"
                android:padding="12dp"
                android:textSize="15sp"
                tools:text="待处理草稿：3 笔（点这里处理）" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_ledger"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/home_action_ledger"
                    android:textSize="17sp" />

                <Button
                    android:id="@+id/btn_report"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:text="@string/home_action_report"
                    android:textSize="17sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btn_settings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/home_action_settings"
                android:textSize="17sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="@string/home_examples"
                android:textSize="13sp" />

        </LinearLayout>
    </ScrollView>

    <!--
      解析结果一行。点它进「账目详情页」看底牌（模型给了什么、分类是怎么定的、
      原始返回长什么样）——这一页已经存在，所以首页不再挂「AI 处理详情」面板。
      没有地方可去时（解析失败）就不可点。

      maxLines + ellipsize 是实机反馈加的：这一段在 ScrollView 之外、又被 weight 抢空间的
      上方内容夹着，文本一多就把它压到几乎看不见——观感上"账本/报表/设置被顶没了"。
      限成 3 行（结论 + 一句说明 + 提示）后，上方内容始终留得住；被截掉的细节点进去看。
    -->
    <TextView
        android:id="@+id/parse_result"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="?android:attr/selectableItemBackground"
        android:ellipsize="end"
        android:lineSpacingExtra="3dp"
        android:maxLines="3"
        android:padding="12dp"
        android:textSize="15sp"
        android:visibility="gone"
        tools:text="已自动记账" />

    <TextView
        android:id="@+id/parsing_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:paddingHorizontal="12dp"
        android:text="@string/home_parsing"
        android:textSize="13sp"
        android:visibility="gone" />

    <!--
      输入栏：[相机] [输入框] [发送]。相机在左是因为它是"另一种输入来源"，
      与输入框是一类；发送在右是因为它决定"这一句怎么发出去"。

      语音输入已整体移除（P3 再做，HANDOFF 决策 49）：真机上系统识别服务不可用，
      留着就是个坏入口；而且一个不录音的记账应用不该申请麦克风权限。
    -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!--
          截图入口。放在输入框左侧而不是塞进右侧那串按钮里：
          右侧是「发送/语音」，都是"这一句怎么发出去"；而相机是另一种输入来源，
          和输入框是一类的（D2 §7 拟的「输入栏左侧加个相机图标」）。
          选图走系统照片选择器，因此这里不需要声明任何权限。
        -->
        <ImageButton
            android:id="@+id/btn_pick_image"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="4dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/home_pick_image"
            android:scaleType="center"
            android:src="@drawable/ic_camera" />

        <!--
          起步一行、最多三行（实机反馈定的，原来是 5 行）。超过三行就在框内上下滚动，
          不做省略号——ellipsize 会把正在编辑的文字藏起来，用户没法核对。
        -->
        <EditText
            android:id="@+id/input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_input_field"
            android:hint="@string/home_input_hint"
            android:imeOptions="actionSend"
            android:importantForAutofill="no"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLines="3"
            android:minHeight="46dp"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp"
            android:textSize="16sp" />

        <ImageButton
            android:id="@+id/btn_send"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_send_button"
            android:contentDescription="@string/home_send"
            android:padding="10dp"
            android:src="@drawable/ic_arrow_up" />

    </LinearLayout>

</LinearLayout>

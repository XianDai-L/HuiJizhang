<?xml version="1.0" encoding="utf-8"?>
<!--
  账本列表。按月看账，行内直接给出「这笔是怎么来的」——
  自动落账的带浅色底与「自动记」标记，用户一眼就知道哪些是自己没确认过的。

  版面：顶栏（返回 + 月份 + 排序）→ 支出/收入两张汇总卡 → 列表 → 底部说明。
  汇总做成两张卡而不是一行文字：这两个数字是用户翻账本时最先看的，
  值得各自占一块位置；挤在一行里就变成了"说明文字"。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/ledger_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_bg"
    android:orientation="vertical"
    tools:context=".ui.ledger.LedgerActivity">

    <!-- ==================== 顶栏 ==================== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_3"
        android:paddingTop="@dimen/space_2"
        android:paddingEnd="@dimen/space_3">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="@dimen/icon_button"
            android:layout_height="@dimen/icon_button"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_back"
            android:scaleType="centerInside"
            android:src="@drawable/ic_back"
            android:tint="@color/ink" />

        <!--
          翻月：三件贴在一起，读作「‹ 2026 年 10 月 ›」。

          marginStart 是实机截图后加的，**不能删**：返回键也是个左箭头，
          两个箭头紧挨着会让人以为"有两个返回键"。隔开 12dp 之后，
          左边的属于"离开这一页"、右边的属于"换一个月"，一眼分得清。
        -->
        <ImageButton
            android:id="@+id/btn_prev_month"
            android:layout_width="30dp"
            android:layout_height="@dimen/icon_button"
            android:layout_marginStart="@dimen/space_3"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/month_prev"
            android:scaleType="centerInside"
            android:src="@drawable/ic_chevron_left"
            android:tint="@color/ink_2" />

        <!-- 年月本身可点：弹滚轮直接跳月，不必一月一月地按 -->
        <TextView
            android:id="@+id/range"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:paddingStart="@dimen/space_1"
            android:paddingTop="@dimen/space_1"
            android:paddingEnd="@dimen/space_1"
            android:paddingBottom="@dimen/space_1"
            android:textColor="@color/ink"
            android:textSize="@dimen/text_amount_row"
            android:textStyle="bold"
            tools:text="2026 年 10 月" />

        <ImageButton
            android:id="@+id/btn_next_month"
            android:layout_width="30dp"
            android:layout_height="@dimen/icon_button"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/month_next"
            android:scaleType="centerInside"
            android:src="@drawable/ic_chevron_right"
            android:tint="@color/ink_2" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!--
          排序切换。做成一个按钮而不是下拉菜单：这里只有两个选项，
          点一下就切比"点开菜单再选"少一步；按钮上写的是"当前按什么排"，
          所以不用先点一次才知道现在是什么口径。

          textColor 是实机反馈加的，**不能删**：borderlessButtonStyle 的文字色由主题决定，
          默认给的是随主题走的主色（浅到底色上几乎看不见），而这个按钮原先没有显式颜色。
        -->
        <!-- 本月 / 总计：开关式的文字按钮，点一下就换时间范围 -->
        <TextView
            android:id="@+id/btn_total"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:paddingStart="@dimen/space_2"
            android:paddingTop="@dimen/space_1"
            android:paddingEnd="@dimen/space_2"
            android:paddingBottom="@dimen/space_1"
            android:text="@string/ledger_total"
            android:textColor="@color/ink_2"
            android:textSize="@dimen/text_body_small"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_sort"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:paddingStart="@dimen/space_2"
            android:paddingEnd="0dp"
            android:textColor="@color/ink_2"
            android:textSize="@dimen/text_body_small"
            tools:text="按发生时间 ▼" />
    </LinearLayout>

    <!-- ==================== 支出 / 收入两张汇总卡 ==================== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_2"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:paddingStart="@dimen/page_padding_h"
        android:paddingEnd="@dimen/page_padding_h">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_4"
            android:paddingTop="14dp"
            android:paddingEnd="@dimen/space_4"
            android:paddingBottom="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.06"
                android:text="@string/ledger_expense"
                android:textColor="@color/ink_3"
                android:textSize="@dimen/text_micro"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/summary_expense"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFeatureSettings="tnum"
                android:textColor="@color/ink"
                android:textSize="21sp"
                android:textStyle="bold"
                tools:text="3,248.50" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_3"
            android:layout_weight="1"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_4"
            android:paddingTop="14dp"
            android:paddingEnd="@dimen/space_4"
            android:paddingBottom="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.06"
                android:text="@string/ledger_income"
                android:textColor="@color/ink_3"
                android:textSize="@dimen/text_micro"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/summary_income"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFeatureSettings="tnum"
                android:textColor="@color/income"
                android:textSize="21sp"
                android:textStyle="bold"
                tools:text="8,200.00" />
        </LinearLayout>
    </LinearLayout>

    <!--
      分类筛选。只列这个月实际出现过的分类（加一个「全部」）：
      把分类树里的分类全摆出来，会有一半是点了没内容的空标签。
      用 HorizontalScrollView 而不是 RecyclerView —— 选项就十来个，
      为它引一套横向适配器不划算。
    -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_4"
        android:clipToPadding="false"
        android:paddingStart="@dimen/page_padding_h"
        android:paddingEnd="@dimen/page_padding_h"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/filter_chips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <TextView
        android:id="@+id/empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_6"
        android:gravity="center"
        android:text="@string/ledger_empty"
        android:textColor="@color/ink_3"
        android:textSize="@dimen/text_body"
        android:visibility="gone"
        tools:visibility="visible" />

    <!--
      列表左右留出与页面同宽的边距，行内再各留 16dp：
      这样文字距屏幕 36dp，与首页「最近账目」卡片里的行完全对齐。
    -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/space_2"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingStart="@dimen/page_padding_h"
        android:paddingEnd="@dimen/page_padding_h"
        android:paddingBottom="@dimen/space_4"
        android:scrollbars="vertical"
        tools:listitem="@layout/item_entry" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/page_padding_h"
        android:paddingTop="@dimen/space_1"
        android:paddingEnd="@dimen/page_padding_h"
        android:paddingBottom="@dimen/space_3"
        android:text="@string/ledger_hint"
        android:textColor="@color/ink_3"
        android:textSize="@dimen/text_micro" />

</LinearLayout>

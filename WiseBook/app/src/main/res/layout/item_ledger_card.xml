<?xml version="1.0" encoding="utf-8"?>
<!--
  账本选择里的一张卡（2026-10-11 / 同日重构）。

  一张卡 = 一个存档，<b>只占三行</b>：
    第 1 行：名字 + 「当前使用」+ 笔数
    第 2 行：创建时间 · 分类方案
    第 3 行：预览分类 / 重命名 / 删除

  初版把整个分类清单铺在卡里，结果一个账本占掉两屏多、往下翻四个账本要滑半天。
  分类清单挪进「预览分类」弹框（用户明确要求），卡片因此缩回三行。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_3"
    android:background="@drawable/bg_card"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:paddingStart="@dimen/space_4"
    android:paddingTop="@dimen/space_3"
    android:paddingEnd="@dimen/space_4"
    android:paddingBottom="@dimen/space_1">

    <!-- ==================== 第 1 行 ==================== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/card_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/ink"
            android:textSize="@dimen/text_title"
            android:textStyle="bold"
            tools:text="默认账本" />

        <!-- 只在当前账本上显示 -->
        <TextView
            android:id="@+id/card_current"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_2"
            android:background="@drawable/badge_background"
            android:paddingStart="@dimen/space_2"
            android:paddingTop="2dp"
            android:paddingEnd="@dimen/space_2"
            android:paddingBottom="2dp"
            android:text="@string/ledger_picker_current_badge"
            android:textColor="@color/brand"
            android:textSize="@dimen/text_micro"
            android:visibility="gone"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/card_entries"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_2"
            android:textColor="@color/ink_2"
            android:textSize="@dimen/text_body_small"
            tools:text="12 笔账目" />
    </LinearLayout>

    <!-- ==================== 第 2 行 ==================== -->
    <TextView
        android:id="@+id/card_meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/ink_3"
        android:textSize="@dimen/text_micro"
        tools:text="创建于 2026-10-11 09:30 · 标准分类" />

    <!-- ==================== 第 3 行：三个动作 ==================== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/card_preview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:paddingStart="@dimen/space_3"
            android:paddingTop="@dimen/space_2"
            android:paddingEnd="@dimen/space_3"
            android:paddingBottom="@dimen/space_2"
            android:text="@string/ledger_picker_action_preview"
            android:textColor="@color/ink_2"
            android:textSize="@dimen/text_body_small" />

        <TextView
            android:id="@+id/card_rename"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:paddingStart="@dimen/space_3"
            android:paddingTop="@dimen/space_2"
            android:paddingEnd="@dimen/space_3"
            android:paddingBottom="@dimen/space_2"
            android:text="@string/ledger_picker_action_rename"
            android:textColor="@color/brand"
            android:textSize="@dimen/text_body_small" />

        <TextView
            android:id="@+id/card_delete"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:paddingStart="@dimen/space_3"
            android:paddingTop="@dimen/space_2"
            android:paddingEnd="@dimen/space_3"
            android:paddingBottom="@dimen/space_2"
            android:text="@string/ledger_picker_action_delete"
            android:textColor="@color/danger"
            android:textSize="@dimen/text_body_small" />
    </LinearLayout>

</LinearLayout>

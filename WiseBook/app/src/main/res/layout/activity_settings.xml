<?xml version="1.0" encoding="utf-8"?>
<!--
  设置页。三组领域设置（D1 §3.5 的 t_setting）+ 一组模型连接配置。
  用 LinearLayout 而不是 ConstraintLayout：这是一张表单，纵向堆叠就是它的全部布局逻辑。
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/settings_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".ui.settings.SettingsActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_confirm_mode"
            android:textSize="17sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/group_confirm_mode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/mode_strict"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_mode_strict" />

            <RadioButton
                android:id="@+id/mode_large"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_mode_large" />

            <RadioButton
                android:id="@+id/mode_doubtful"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_mode_doubtful" />
        </RadioGroup>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/settings_threshold"
            android:textSize="15sp" />

        <EditText
            android:id="@+id/threshold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:importantForAutofill="no"
            android:inputType="number"
            android:maxLength="7"
            tools:text="300" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="@string/settings_scheme"
            android:textSize="17sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/group_scheme"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/scheme_simple"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_scheme_simple" />

            <RadioButton
                android:id="@+id/scheme_standard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_scheme_standard" />
        </RadioGroup>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="@string/settings_provider"
            android:textSize="17sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/group_provider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/provider_siliconflow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="硅基流动" />

            <RadioButton
                android:id="@+id/provider_deepseek"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="DeepSeek 官方" />
        </RadioGroup>

        <EditText
            android:id="@+id/model"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/settings_model_hint"
            android:importantForAutofill="no"
            android:inputType="text" />

        <EditText
            android:id="@+id/api_key"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/settings_api_key_hint"
            android:importantForAutofill="no"
            android:inputType="textPassword" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/settings_credentials_note"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btn_save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/settings_action_save"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:textSize="14sp"
            tools:text="已保存" />

    </LinearLayout>

</ScrollView>

<?xml version="1.0" encoding="utf-8"?>
<!--
  分类预览（2026-10-11）。

  原先是账本卡片里内嵌的清单，现在搬进弹框——卡片因此能缩回三行。
  顶部两句：一句说明"这个账本用的是哪种方案、所以看到的是几级"，
  一句是汇总（共 N 个一级分类 · M 个子分类）。

  简单方案下不渲染二级：这不是"藏起来"，而是这个账本本来就用不到它们。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/space_5"
    android:paddingTop="@dimen/space_1"
    android:paddingEnd="@dimen/space_5"
    android:paddingBottom="@dimen/space_4">

    <TextView
        android:id="@+id/preview_note"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/ink_2"
        android:textSize="@dimen/text_body_small"
        tools:text="这个账本用的是「标准」：可以用到二级分类。" />

    <TextView
        android:id="@+id/preview_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_2"
        android:textColor="@color/ink_3"
        android:textSize="@dimen/text_micro"
        tools:text="共 16 个一级分类 · 37 个子分类" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_3"
        android:scrollbars="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 支出组 -->
            <TextView
                android:id="@+id/preview_expense_header"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.12"
                android:text="@string/category_overview_expense"
                android:textColor="@color/ink_3"
                android:textSize="@dimen/text_micro"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/preview_expense_groups"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:divider="@drawable/divider_line"
                android:orientation="vertical"
                android:showDividers="middle" />

            <!-- 收入组 -->
            <TextView
                android:id="@+id/preview_income_header"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_5"
                android:letterSpacing="0.12"
                android:text="@string/category_overview_income"
                android:textColor="@color/ink_3"
                android:textSize="@dimen/text_micro"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/preview_income_groups"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:divider="@drawable/divider_line"
                android:orientation="vertical"
                android:showDividers="middle" />
        </LinearLayout>
    </ScrollView>

</LinearLayout>

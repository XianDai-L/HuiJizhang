<?xml version="1.0" encoding="utf-8"?>
<!--
  账目详情。

  2026-10-07 重排，三处按实机反馈改的：

  1) 字段区从「四个分区各自一段」收成<b>一张表</b>：金额/时间/明细/入账这些分区标题
     对日常查看是噪音，用户只想看商户对不对、分类对不对。原来四组数据仍在
     ViewModel 里保留着（见 EntryDetailViewModel.Detail 的注释），只是不铺在正面。

  2) <b>「改正分类」搬到了「分类」那一行</b>：这一页最高频的动作就是改分类，
     让它长在字段上（点行即改），比在页面底部放一个按钮少一步。

  3) <b>「删除」收进右上角的三点菜单</b>：撤销是低频且不可逆的动作，
     摆在正中间容易误触；收进溢出菜单之后，误触成本高了一档。

  保留原样的是「输入解析」：仍然默认收起，展开后是原图（可点开看大图）、
  原话与模型诊断。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/detail_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_bg"
    android:orientation="vertical"
    tools:context=".ui.ledger.EntryDetailActivity">

    <!-- ==================== 顶栏 ==================== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_3"
        android:paddingTop="@dimen/space_2"
        android:paddingEnd="@dimen/space_3">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="@dimen/icon_button"
            android:layout_height="@dimen/icon_button"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_back"
            android:scaleType="centerInside"
            android:src="@drawable/ic_back"
            android:tint="@color/ink" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/detail_title"
            android:textColor="@color/ink"
            android:textSize="@dimen/text_title"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btn_more"
            android:layout_width="@dimen/icon_button"
            android:layout_height="@dimen/icon_button"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/detail_more"
            android:scaleType="centerInside"
            android:src="@drawable/ic_more"
            android:tint="@color/ink" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/page_padding_h"
            android:paddingEnd="@dimen/page_padding_h"
            android:paddingBottom="@dimen/page_padding_bottom">

            <!--
              ==================== 金额：这一页的主角，点它可改 ====================

              2026-10-08：已入账的账目要能改金额。动作长在金额本身上，
              而不是再放一个「修改金额」按钮——和「分类」那一行是同一个思路。
            -->
            <TextView
                android:id="@+id/amount"
                style="@style/Text.Amount.Detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingTop="@dimen/space_1"
                android:paddingBottom="@dimen/space_1"
                tools:text="283.40 元" />

            <!-- 可点的地方得说出来：金额看着就是个数字，没有这句没人会去点它 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/detail_amount_editable"
                android:textColor="@color/ink_3"
                android:textSize="@dimen/text_micro" />

            <TextView
                android:id="@+id/direction_category"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:gravity="center"
                android:textColor="@color/ink_2"
                android:textSize="@dimen/text_body_small"
                tools:text="支出 · 娱乐 &gt; 游戏" />

            <!-- ==================== 字段表 ==================== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_5"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:paddingStart="@dimen/space_4"
                android:paddingEnd="@dimen/space_4">

                <LinearLayout
                    android:id="@+id/detail_rows"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:divider="@drawable/divider_line"
                    android:orientation="vertical"
                    android:showDividers="middle" />
            </LinearLayout>

            <!--
              原图。截图入口才有（文字入口没有证据文件）。

              它放在页面正面、折叠区<b>外面</b>：这是"最强的一句解释"（这笔就是从这张图来的），
              藏在"输入解析"后面等人点开是不对的——2026-10-07 反馈"原图不见了"，
              实际就是它被收进了折叠区。点它可以全屏看大图。
            -->
            <ImageView
                android:id="@+id/evidence_image"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginTop="@dimen/space_4"
                android:background="@drawable/bg_card_sunken"
                android:contentDescription="@string/detail_evidence_image"
                android:scaleType="fitCenter"
                android:visibility="gone"
                tools:src="@tools:sample/backgrounds/scenic" />

            <TextView
                android:id="@+id/status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_3"
                android:textColor="@color/ink_2"
                android:textSize="@dimen/text_body_small" />

            <!-- ==================== 输入解析（查阅性内容，默认收起） ==================== -->
            <Button
                android:id="@+id/btn_toggle_parse"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:gravity="start|center_vertical"
                android:minWidth="0dp"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:text="@string/detail_section_input"
                android:textColor="@color/ink_3"
                android:textSize="@dimen/text_body_small"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/parse_panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/raw_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_3"
                    android:textColor="@color/ink_3"
                    android:textSize="@dimen/text_micro"
                    tools:text="你原来说的" />

                <TextView
                    android:id="@+id/raw_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/ink"
                    android:textSize="@dimen/text_body"
                    tools:text="我买游戏花了283.4" />

                <TextView
                    android:id="@+id/parse_details"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_3"
                    android:background="@drawable/bg_card_sunken"
                    android:fontFamily="monospace"
                    android:lineSpacingExtra="2dp"
                    android:padding="@dimen/space_3"
                    android:textColor="@color/ink_2"
                    android:textIsSelectable="true"
                    android:textSize="@dimen/text_micro"
                    tools:text="模型    deepseek:deepseek-chat" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>

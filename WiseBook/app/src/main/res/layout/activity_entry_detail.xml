<?xml version="1.0" encoding="utf-8"?>
<!--
  账目详情。

  「输入解析」刻意默认收起：多数时候用户只想确认"这笔记对了吗"，
  一句原话就够了；想追"它凭什么这么记"时再展开。
  展开后的内容是现成的 DiagnosticsFormatter 输出，不是另写一套。
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/detail_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".ui.ledger.EntryDetailActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:text="@string/detail_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="@color/muted" />

        <TextView
            android:id="@+id/amount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textSize="28sp"
            android:textStyle="bold"
            tools:text="283.40 元" />

        <TextView
            android:id="@+id/direction_category"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textSize="15sp"
            tools:text="支出 · 娱乐 &gt; 游戏" />

        <!--
          收起时只留一行标题：截图入口的原文可能是一整页账单的转写文本，
          展开着会把下面四个字段区和操作按钮全顶到屏幕外。想看的时候点一下标题。

          textColor 是实机反馈加的，**不能删**：borderlessButtonStyle 的文字色由主题决定，
          默认给的是随主题走的主色（浅到底色上几乎看不见，用户原话是"字体颜色为白色"），
          而这个按钮原先没有显式颜色。字形也从 ▸ 换成 ▶（实心大三角），小三角不显眼。
        -->
        <Button
            android:id="@+id/btn_toggle_parse"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="start|center_vertical"
            android:minWidth="0dp"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:text="@string/detail_section_input"
            android:textColor="@color/muted"
            android:textSize="15sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/parse_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <!--
              原图。截图入口才有（文字/语音入口没有证据文件）。
              放在最前面是因为它是最强的解释：用户一眼就能确认"这笔就是从这张图来的"。
            -->
            <ImageView
                android:id="@+id/evidence_image"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:layout_marginTop="6dp"
                android:background="@color/pane_background"
                android:contentDescription="@string/detail_evidence_image"
                android:scaleType="fitCenter"
                android:visibility="gone"
                tools:src="@tools:sample/backgrounds/scenic" />

            <TextView
                android:id="@+id/raw_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/muted"
                android:textSize="12sp"
                tools:text="你原来说的" />

            <TextView
                android:id="@+id/raw_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textSize="14sp"
                tools:text="我买游戏花了283.4" />

            <TextView
                android:id="@+id/parse_details"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@color/pane_background"
                android:fontFamily="monospace"
                android:lineSpacingExtra="2dp"
                android:padding="10dp"
                android:textIsSelectable="true"
                android:textSize="12sp"
                tools:text="模型    deepseek:deepseek-chat" />
        </LinearLayout>

        <!-- ================= 四个字段区（每个容器内部按两列排） ================= -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/detail_section_amount"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/amount_rows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/detail_section_time"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/time_rows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/detail_section_fields"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/field_rows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/detail_section_posting"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/posting_rows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textSize="13sp" />

        <!-- ================= 动作（并排：两个按钮各占一行会把它们推到屏幕之外） ================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_correct"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="1"
                android:text="@string/ledger_action_correct"
                android:textSize="15sp" />

            <Button
                android:id="@+id/btn_void"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:maxLines="1"
                android:text="@string/ledger_action_void"
                android:textSize="15sp" />
        </LinearLayout>

    </LinearLayout>

</ScrollView>

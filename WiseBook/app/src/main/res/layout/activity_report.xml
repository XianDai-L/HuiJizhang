<?xml version="1.0" encoding="utf-8"?>
<!--
  报表。本月合计 + 按一级分类汇总 + 估算浮动提示（D1 §2 的展示口径）。

  版面：顶栏 → 合计（支出为主角、收入次之）→ 转账口径开关 → 分类明细卡片 → 说明。
  分类明细用 LinearLayout 动态塞行而不是 RecyclerView：
  一级分类最多十来个，没必要为一个静态小列表再引一套 Adapter。

  结构变化：根节点从 ScrollView 换成了 LinearLayout，ScrollView 只包内容区。
  这样顶栏固定，滚动时不会带着标题一起跑。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/report_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_bg"
    android:orientation="vertical"
    tools:context=".ui.report.ReportActivity">

    <!-- ==================== 顶栏 ==================== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_3"
        android:paddingTop="@dimen/space_2"
        android:paddingEnd="@dimen/space_3">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="@dimen/icon_button"
            android:layout_height="@dimen/icon_button"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_back"
            android:scaleType="centerInside"
            android:src="@drawable/ic_back"
            android:tint="@color/ink" />

        <!-- 翻月：三件贴在一起，读作「‹ 2026 年 10 月 ›」 -->
        <ImageButton
            android:id="@+id/btn_prev_month"
            android:layout_width="30dp"
            android:layout_height="@dimen/icon_button"
            android:layout_marginStart="@dimen/space_3"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/month_prev"
            android:scaleType="centerInside"
            android:src="@drawable/ic_chevron_left"
            android:tint="@color/ink_2" />

        <!-- 年月本身可点：弹滚轮直接跳月，与账本页是同一套操作 -->
        <TextView
            android:id="@+id/range"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:paddingStart="@dimen/space_1"
            android:paddingTop="@dimen/space_1"
            android:paddingEnd="@dimen/space_1"
            android:paddingBottom="@dimen/space_1"
            android:textColor="@color/ink"
            android:textSize="@dimen/text_amount_row"
            android:textStyle="bold"
            tools:text="2026 年 10 月" />

        <ImageButton
            android:id="@+id/btn_next_month"
            android:layout_width="30dp"
            android:layout_height="@dimen/icon_button"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/month_next"
            android:scaleType="centerInside"
            android:src="@drawable/ic_chevron_right"
            android:tint="@color/ink_2" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- 本月 / 总计：与账本页是同一件事，两页的表现要对得上 -->
        <TextView
            android:id="@+id/btn_total"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:paddingStart="@dimen/space_2"
            android:paddingTop="@dimen/space_1"
            android:paddingEnd="0dp"
            android:paddingBottom="@dimen/space_1"
            android:text="@string/ledger_total"
            android:textColor="@color/ink_2"
            android:textSize="@dimen/text_body_small"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/page_padding_h"
            android:paddingEnd="@dimen/page_padding_h"
            android:paddingBottom="@dimen/page_padding_bottom">

            <!-- ==================== 合计 ==================== -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:letterSpacing="0.07"
                android:text="@string/report_total_expense"
                android:textColor="@color/ink_3"
                android:textSize="@dimen/text_micro"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/expense_total"
                style="@style/Text.Amount.Detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                tools:text="3,240.00 元" />

            <TextView
                android:id="@+id/estimate_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:textColor="@color/ink_3"
                android:textSize="@dimen/text_micro"
                android:visibility="gone"
                tools:text="含 8 笔估算，浮动约 ±85.00 元"
                tools:visibility="visible" />

            <!-- 收入是次要信息：同一屏里两个同样大的数字，用户反而不知道该看哪个 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_5"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/report_income"
                    android:textColor="@color/ink_2"
                    android:textSize="@dimen/text_body_small" />

                <TextView
                    android:id="@+id/income_total"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFeatureSettings="tnum"
                    android:textColor="@color/income"
                    android:textSize="@dimen/text_title"
                    android:textStyle="bold"
                    tools:text="0.00 元" />
            </LinearLayout>

            <TextView
                android:id="@+id/empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:gravity="center"
                android:text="@string/report_empty"
                android:textColor="@color/ink_3"
                android:textSize="@dimen/text_body"
                android:visibility="gone"
                tools:visibility="visible" />

            <!-- ==================== 分类明细 ==================== -->
            <TextView
                android:id="@+id/expense_header"
                style="@style/Text.Section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_6"
                android:text="@string/report_expense_by_root" />

            <LinearLayout
                android:id="@+id/expense_rows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:paddingStart="@dimen/space_4"
                android:paddingTop="6dp"
                android:paddingEnd="@dimen/space_4"
                android:paddingBottom="6dp" />

            <TextView
                android:id="@+id/income_header"
                style="@style/Text.Section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_6"
                android:text="@string/report_income_by_root"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/income_rows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:paddingStart="@dimen/space_4"
                android:paddingTop="6dp"
                android:paddingEnd="@dimen/space_4"
                android:paddingBottom="6dp" />

            <!-- ==================== 转账口径（放在分类明细下方） ==================== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_6"
                android:background="@drawable/bg_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/space_4"
                android:paddingEnd="@dimen/space_4">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingTop="@dimen/space_3"
                    android:paddingBottom="@dimen/space_3">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/report_exclude_transfer"
                        android:textColor="@color/ink"
                        android:textSize="@dimen/text_body" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/report_exclude_transfer_note"
                        android:textColor="@color/ink_3"
                        android:textSize="@dimen/text_micro" />
                </LinearLayout>

                <!-- 用「开启」而不是勾选：这是一个开关，不是多项选择里的一项 -->
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/exclude_transfer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_3"
                    android:minHeight="@dimen/touch_target" />
            </LinearLayout>

            <TextView
                android:id="@+id/transfer_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:textColor="@color/ink_3"
                android:textSize="@dimen/text_micro"
                android:visibility="gone"
                tools:text="已排除 2 笔转账"
                tools:visibility="visible" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_6"
                android:text="@string/report_hint"
                android:textColor="@color/ink_3"
                android:textSize="@dimen/text_micro" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>

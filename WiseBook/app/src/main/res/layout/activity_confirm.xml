<?xml version="1.0" encoding="utf-8"?>
<!--
  确认页。D1 §4 里 ASKING 状态的界面：既展示「为什么需要确认」，
  也承载反问清单与字段修改。改完点「保存修改并重新校验」会回流 DRAFT 重跑一遍判据（§4.2 约束 1）。

  2026-10-07 重排，结构做了两处调整：

  1) 根节点从 ScrollView 换成 LinearLayout，三个操作按钮<b>移出滚动区、固定在屏幕底部</b>。
     原来的问题很直白：按钮排在滚动内容的最后，而这一页的内容（反问 + 金额 + 方向 +
     分类 + 支付 + 时间 + 商户 + 原文）在任何一台手机上都超过一屏，
     于是「确认记账」永远要先下滑才看得见。按钮脱离滚动区之后，二级分类再长也不影响它。

  2) 「为什么需要确认」从光秃秃的两行字收进一张卡片，问题与理由有了归属，
     用户一眼能分清「系统在说什么」和「要我做什么」。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/confirm_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_bg"
    android:orientation="vertical"
    tools:context=".ui.confirm.ConfirmActivity">

    <!-- ==================== 顶栏 ==================== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_3"
        android:paddingTop="@dimen/space_2"
        android:paddingEnd="@dimen/space_3">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="@dimen/icon_button"
            android:layout_height="@dimen/icon_button"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_back"
            android:scaleType="centerInside"
            android:src="@drawable/ic_back"
            android:tint="@color/ink" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/confirm_title"
            android:textColor="@color/ink"
            android:textSize="@dimen/text_title"
            android:textStyle="bold" />

        <View
            android:layout_width="@dimen/icon_button"
            android:layout_height="@dimen/icon_button" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/page_padding_h"
            android:paddingEnd="@dimen/page_padding_h">

            <!-- ==================== 为什么要你核对 ==================== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:paddingStart="@dimen/space_4"
                android:paddingTop="14dp"
                android:paddingEnd="@dimen/space_4"
                android:paddingBottom="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.12"
                    android:text="@string/confirm_why"
                    android:textColor="@color/ink_3"
                    android:textSize="@dimen/text_micro"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/why"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_1"
                    android:textColor="@color/ink"
                    android:textSize="@dimen/text_body"
                    tools:text="金额达到大额阈值（6800 元 ≥ 300 元）" />

                <TextView
                    android:id="@+id/questions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_2"
                    android:textColor="@color/brand_ink"
                    android:textSize="@dimen/text_body_small"
                    tools:text="需要你补充的：这笔具体是多少钱？" />
            </LinearLayout>

            <!-- ==================== 金额 ==================== -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_5"
                android:letterSpacing="0.12"
                android:text="@string/confirm_amount"
                android:textColor="@color/ink_3"
                android:textSize="@dimen/text_micro"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/amount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:background="@drawable/bg_input_field"
                android:importantForAutofill="no"
                android:inputType="numberDecimal"
                android:paddingStart="18dp"
                android:paddingTop="@dimen/space_3"
                android:paddingEnd="18dp"
                android:paddingBottom="@dimen/space_3"
                android:textColor="@color/ink"
                android:textSize="27sp"
                android:textStyle="bold"
                tools:text="6800" />

            <!-- 方向不另起标签：两个单选按钮上的「支出 / 收入」已经把话说完了，省下一行 -->
            <RadioGroup
                android:id="@+id/group_direction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/direction_expense"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/touch_target"
                    android:text="支出"
                    android:textColor="@color/ink"
                    android:textSize="@dimen/text_body" />

                <RadioButton
                    android:id="@+id/direction_income"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_4"
                    android:minHeight="@dimen/touch_target"
                    android:text="收入"
                    android:textColor="@color/ink"
                    android:textSize="@dimen/text_body" />
            </RadioGroup>

            <!-- 分类与支付方式并排：两项各自只有一个按钮，并排省下一整行 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.12"
                        android:text="@string/confirm_category"
                        android:textColor="@color/ink_3"
                        android:textSize="@dimen/text_micro"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btn_category"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_1"
                        android:maxLines="1"
                        android:textAllCaps="false"
                        android:textSize="@dimen/text_body_small"
                        tools:text="餐饮&gt;外卖" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_2"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.12"
                        android:text="@string/confirm_payment"
                        android:textColor="@color/ink_3"
                        android:textSize="@dimen/text_micro"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btn_payment"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_1"
                        android:maxLines="1"
                        android:textAllCaps="false"
                        android:textSize="@dimen/text_body_small"
                        tools:text="未填（可以不填）" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/occurred_at"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_3"
                android:textColor="@color/ink_2"
                android:textSize="@dimen/text_body_small"
                tools:text="发生时间：2026-09-24 20:30（原句明确写了）" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:letterSpacing="0.12"
                android:text="@string/confirm_merchant"
                android:textColor="@color/ink_3"
                android:textSize="@dimen/text_micro"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/merchant"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:background="@drawable/bg_input_field"
                android:importantForAutofill="no"
                android:inputType="text"
                android:paddingStart="18dp"
                android:paddingTop="@dimen/space_3"
                android:paddingEnd="18dp"
                android:paddingBottom="@dimen/space_3"
                android:textColor="@color/ink"
                android:textSize="@dimen/text_body"
                tools:text="楼下小馆" />

            <!--
              原始输入默认折叠。它常是一整段截图转写文本，展开着会把内容区顶得很长；
              需要核对时点开就行——"想看的时候点一下"比"一进来就被半屏长文挤走"更符合此刻要做的事。
            -->
            <TextView
                android:id="@+id/btn_toggle_raw"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:background="?android:attr/selectableItemBackground"
                android:paddingTop="@dimen/space_1"
                android:paddingBottom="@dimen/space_1"
                android:textColor="@color/ink_3"
                android:textSize="@dimen/text_body_small"
                android:textStyle="bold"
                tools:text="你原来说的 ▶" />

            <TextView
                android:id="@+id/raw_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:background="@drawable/bg_card_sunken"
                android:padding="@dimen/space_3"
                android:textColor="@color/ink_2"
                android:textSize="@dimen/text_micro"
                android:visibility="gone"
                tools:text="今天打车 28" />

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/space_6" />
        </LinearLayout>
    </ScrollView>

    <!-- ==================== 操作（固定在底部，不随内容滚动） ==================== -->
    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/page_padding_h"
        android:paddingTop="@dimen/space_2"
        android:paddingEnd="@dimen/page_padding_h"
        android:textColor="@color/ink_2"
        android:textSize="@dimen/text_body_small" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/page_bg"
        android:orientation="horizontal"
        android:paddingStart="@dimen/page_padding_h"
        android:paddingTop="@dimen/space_2"
        android:paddingEnd="@dimen/page_padding_h"
        android:paddingBottom="@dimen/page_padding_bottom">

        <Button
            android:id="@+id/btn_post"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:text="@string/confirm_action_post"
            android:textSize="@dimen/text_body_small" />

        <Button
            android:id="@+id/btn_save"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_2"
            android:layout_weight="1"
            android:maxLines="1"
            android:text="@string/confirm_action_save"
            android:textColor="@color/ink_2"
            android:textSize="@dimen/text_body_small" />

        <Button
            android:id="@+id/btn_discard"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_1"
            android:maxLines="1"
            android:minWidth="0dp"
            android:paddingStart="@dimen/space_2"
            android:paddingEnd="0dp"
            android:text="@string/confirm_action_discard"
            android:textColor="@color/ink_3"
            android:textSize="@dimen/text_body_small" />
    </LinearLayout>

</LinearLayout>

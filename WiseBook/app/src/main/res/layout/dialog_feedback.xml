<?xml version="1.0" encoding="utf-8"?>
<!--
  意见反馈的表单（2026-10-08）。

  刻意只有一个输入框：反馈这件事的门槛越低，用户越可能真的写一句；
  字段一多、还要选类型填标题，人就干脆不写了。

  自动附带的诊断信息在下面用小字说明白——用户可以不同意，但应该知道
  （实际只带版本与机型，不带任何账目内容，见 SettingsActivity#diagnostics）。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/space_5"
    android:paddingTop="@dimen/space_3"
    android:paddingEnd="@dimen/space_5"
    android:paddingBottom="@dimen/space_1">

    <EditText
        android:id="@+id/feedback_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:autofillHints="@null"
        android:gravity="top|start"
        android:hint="@string/settings_feedback_input_hint"
        android:importantForAutofill="no"
        android:inputType="textMultiLine|textCapSentences"
        android:maxLines="8"
        android:minLines="4"
        android:textColor="@color/ink"
        android:textColorHint="@color/ink_3"
        android:textSize="@dimen/text_body" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_2"
        android:text="@string/settings_feedback_privacy"
        android:textColor="@color/ink_3"
        android:textSize="@dimen/text_micro" />

</LinearLayout>

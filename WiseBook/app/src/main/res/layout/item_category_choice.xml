<?xml version="1.0" encoding="utf-8"?>
<!--
  分类选择器下方的一行可选末级分类。
  有二级时补一行灰色路径，让用户看清自己选的是哪一条。

  左右留白由容器给（见 dialog_pick_category），行本身只管上下内边距——
  这样分隔线能横跨整行，文字也和一级标签对齐。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?android:attr/selectableItemBackground"
    android:minHeight="@dimen/touch_target"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:paddingTop="13dp"
    android:paddingBottom="13dp">

    <TextView
        android:id="@+id/choice_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/ink"
        android:textSize="@dimen/text_body"
        tools:text="外卖" />

    <TextView
        android:id="@+id/choice_path"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/ink_3"
        android:textSize="@dimen/text_micro"
        tools:text="餐饮 &gt; 外卖" />

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<!--
  新建账本（2026-10-11）。

  三样：名字、分类方案（简单 / 标准）、以及"预览这套分类"。
  方案之所以要在这里选：它是<b>按账本</b>存的，建账本的时候就该定下来，
  而不是建完再进设置页找一遍（设置页那一行改的是"当前账本"，很容易改错对象）。

  两个 RadioButton 直接摆出来而不做成"点一行再弹一层"：只有两个选项，
  再套一层只会多一次点击。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/space_5"
    android:paddingTop="@dimen/space_2"
    android:paddingEnd="@dimen/space_5"
    android:paddingBottom="@dimen/space_1">

    <EditText
        android:id="@+id/new_ledger_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/ledger_picker_name_hint"
        android:importantForAutofill="no"
        android:inputType="text"
        android:maxLines="1" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_4"
        android:text="@string/ledger_new_scheme_label"
        android:textColor="@color/ink"
        android:textSize="@dimen/text_body" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="@string/ledger_new_scheme_note"
        android:textColor="@color/ink_3"
        android:textSize="@dimen/text_micro" />

    <RadioGroup
        android:id="@+id/new_ledger_scheme"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_1"
        android:orientation="vertical">

        <RadioButton
            android:id="@+id/new_ledger_scheme_simple"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_scheme_simple"
            android:textColor="@color/ink"
            android:textSize="@dimen/text_body" />

        <RadioButton
            android:id="@+id/new_ledger_scheme_standard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_scheme_standard"
            android:textColor="@color/ink"
            android:textSize="@dimen/text_body" />
    </RadioGroup>

    <TextView
        android:id="@+id/new_ledger_preview"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_1"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:paddingTop="@dimen/space_2"
        android:paddingEnd="@dimen/space_3"
        android:paddingBottom="@dimen/space_2"
        android:text="@string/ledger_new_preview"
        android:textColor="@color/brand"
        android:textSize="@dimen/text_body_small"
        tools:ignore="RtlSymmetry" />

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<!--
  发送按钮的底：圆形 + 按住涟漪。
  加禁用态是因为输入框为空时按钮应当是「看得见的灰」而不是消失 ——
  位置不变，用户不会找不到它。
-->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#33FFFFFF">
    <item>
        <selector>
            <item android:state_enabled="false">
                <shape android:shape="oval">
                    <solid android:color="@color/composer_send_disabled" />
                </shape>
            </item>
            <item>
                <shape android:shape="oval">
                    <solid android:color="@color/composer_send" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>

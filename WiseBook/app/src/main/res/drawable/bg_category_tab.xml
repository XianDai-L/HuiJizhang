<?xml version="1.0" encoding="utf-8"?>
<!--
  分类选择器里「一级分类」标签的底：选中填充、未选中描边。
  用 selector 而不是在代码里改颜色，是为了让状态切换由系统按 selected 状态自动处理——
  代码只需要 setSelected(true/false)，不必记住"上一个选中的是谁"再手动还原。
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/category_tab_selected" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/category_tab_normal" />
            <corners android:radius="16dp" />
            <stroke
                android:width="1dp"
                android:color="@color/category_tab_stroke" />
        </shape>
    </item>
</selector>

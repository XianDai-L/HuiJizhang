<?xml version="1.0" encoding="utf-8"?>
<!--
  左箭头：顶栏翻到上一个月。

  **必须与 ic_chevron_right 严格镜像**（同样的折线长度、同样的描边宽度）。
  这个文件最初是照着别处的箭头随手画的（6×12、描边 2.0），而右箭头是 6.5×13、描边 2.2，
  结果顶栏两个箭头一大一小一粗一细，看着像没对齐。现在两边都按同一组数值来：
  折线 6.5 格宽、13 格高、描边 2.2，端点圆角。

  x 坐标由右箭头镜像而来（24 - x）：右是 M9.5,5.5 → L16,12 → l-6.5,6.5，
  左就是 M14.5,5.5 → L8,12 → l6.5,6.5。

  颜色不在这里写死：交给使用处的 android:tint（顶栏用的是 @color/ink_2），
  两个箭头因此永远同色。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:pathData="M14.5,5.5L8,12l6.5,6.5"
        android:fillColor="#00000000"
        android:strokeColor="#FF000000"
        android:strokeWidth="2.2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
</vector>

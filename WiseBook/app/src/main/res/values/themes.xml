<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
      把品牌色正式接进 Material 3 的色彩角色。

      之前这里一个 item 都没配（只有两行注释），结果是：
      控件的默认色来自 M3 基线紫 #6750A4，而布局里手写的是 @color/auto_posted_badge，
      同屏会出现两种不同的紫。现在两者统一到 @color/brand。
    -->
    <style name="Base.Theme.WiseBook" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- 品牌：全应用唯一的强调色 -->
        <item name="colorPrimary">@color/brand</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/brand_soft</item>
        <item name="colorOnPrimaryContainer">@color/brand_ink</item>
        <item name="colorSecondary">@color/brand</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSecondaryContainer">@color/brand_soft</item>
        <item name="colorOnSecondaryContainer">@color/brand_ink</item>

        <!-- 开关、单选这类控件的「开启/选中」色统一走品牌紫：
             默认会取 M3 的基线紫，和页面里的 @color/brand 又是两个紫 -->
        <item name="colorControlActivated">@color/brand</item>

        <!-- 危险：只给危险操作 -->
        <item name="colorError">@color/danger</item>
        <item name="colorOnError">@color/white</item>
        <item name="colorErrorContainer">@color/danger_soft</item>
        <item name="colorOnErrorContainer">@color/danger</item>

        <!-- 底色与容器 -->
        <item name="android:colorBackground">@color/page_bg</item>
        <item name="colorOnBackground">@color/ink</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="colorSurfaceVariant">@color/surface_sunken</item>
        <item name="colorOnSurfaceVariant">@color/ink_2</item>
        <item name="colorOutline">@color/line</item>
        <item name="colorOutlineVariant">@color/line</item>

        <!-- Surface 容器层级：Snackbar、菜单这类组件会用到 -->
        <item name="colorSurfaceContainerLowest">@color/surface</item>
        <item name="colorSurfaceContainerLow">@color/surface</item>
        <item name="colorSurfaceContainer">@color/surface_sunken</item>
        <item name="colorSurfaceContainerHigh">@color/surface_sunken</item>
        <item name="colorSurfaceContainerHighest">@color/surface_sunken</item>

        <!-- 系统栏交给 EdgeToEdgeInsets 处理，这里只声明透明 -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <!-- 暖白底上系统栏图标用深色 -->
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.WiseBook" parent="Base.Theme.WiseBook" />
</resources>
